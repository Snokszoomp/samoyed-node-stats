### Telegram
TELEGRAM_BOT_TOKEN=123456:ABCDEF_your_token_here
TELEGRAM_CHAT_ID=123456789

### Remnawave API
# Base URL панели, например: https://panel.example.com
REMNAWAVE_API_URL=https://panel.example.com

# Один из вариантов авторизации (JWT Bearer):
REMNAWAVE_API_TOKEN=your_api_token_here

# Egames-совместимый логин через "секрет-куку":
# Бот сделает запрос на /auth/login?{COOKIE_NAME}={COOKIE_VALUE} и получит сессию.
REMNAWAVE_EGAMES_COOKIE_NAME=
REMNAWAVE_EGAMES_COOKIE_VALUE=

# Путь до эндпоинта со списком нод (относительно REMNAWAVE_API_URL)
REMNAWAVE_NODES_PATH=/api/nodes

# Проверять TLS сертификат (true/false)
REMNAWAVE_VERIFY_TLS=true

### Monitoring
# Интервал опроса в секундах
POLL_INTERVAL_SECONDS=60

# Лимит пользователей на ноду (если превышен — “перегруз”)
NODE_USERS_LIMIT=250

# Чтобы не спамить о перегрузе каждую минуту: минимальный интервал повторного алерта (сек)
OVERLOAD_REPEAT_SECONDS=600

# Уровень логов (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

